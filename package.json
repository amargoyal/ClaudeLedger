{
  "name": "claude-ledger",
  "version": "1.1.0",
  "private": true,
  "description": "Mac and Windows dashboard for your Claude Code usage, authenticated with your Claude account (no API key).",
  "author": "Amar Goyal",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node server.js",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && electron-builder --mac dmg",
    "dist:unpacked": "npm run icon && electron-builder --mac dir",
    "dist:win": "npm run icon && electron-builder --win nsis --x64 --arm64",
    "dist:win:unpacked": "npm run icon && electron-builder --win dir",
    "test": "node scripts/qr-selftest.mjs && node scripts/failover-selftest.mjs && node scripts/burn-selftest.mjs",
    "ios:add": "cap add ios && npm run ios:configure",
    "ios:sync": "cap sync ios && npm run ios:configure",
    "ios:configure": "node scripts/ios-configure.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.amargoyal.claudeledger",
    "productName": "Claude Ledger",
    "copyright": "Copyright © 2026 Amar Goyal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "mobile/**/*",
      "server.js",
      "package.json",
      "!node_modules/@capacitor{,/**}"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 Amar Goyal"
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Claude Ledger",
      "artifactName": "ClaudeLedger-${version}-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "ClaudeLedger-${version}-${arch}.dmg",
      "title": "Claude Ledger ${version}",
      "backgroundColor": "#f6f1e8",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
